# ---------------------------------------------------------------------------
# EM Auth — variables d'environnement de l'interface
#
# Tout ce qui commence par VITE_ est INCLUS DANS LE BUNDLE et donc PUBLIC.
# Aucun secret, aucune clé privée, aucun jeton ne doit figurer ici.
# Les secrets (client_secret OIDC, clés de signature, DSN) restent côté BFF.
# ---------------------------------------------------------------------------

# Mode de la couche de services :
#   demo -> backend en mémoire, aucune requête réseau (défaut)
#   http -> BFF réel (dossier app/ du projet EM-Auth)
VITE_API_MODE=demo

# Base des appels HTTP. Vide = même origine (le BFF sert l'application).
# Exemple : http://localhost:3000
VITE_API_BASE_URL=

# Latence simulée du backend de démonstration, en millisecondes.
# Sert à éprouver les états d'attente ; 0 en tests.
VITE_DEMO_LATENCE_MS=320

# Durée d'une session de démonstration, en minutes (aucune valeur contractuelle).
VITE_SESSION_DUREE_MIN=20

# Fenêtre de preuve fraîche affichée par l'interface, en minutes.
# Alignée sur la politique S05 : freshness.windowMs = 300000 ms.
VITE_PREUVE_FRAICHE_MIN=5

# Intervalle d'interrogation de l'état de session, en millisecondes.
VITE_SESSION_POLL_MS=15000

# Ouvre une session de démonstration au démarrage (test de rendu uniquement).
# Ne jamais activer dans une démonstration montrée à un tiers.
VITE_DEMO_SESSION_INITIALE=0
