{
  "name": "em-auth-maquette",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Maquette navigable EM AUTH — React 19 + TypeScript. Données fictives, aucun service connecté.",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "verifier": "tsc -b --noEmit",
    "audit": "node scripts/audit.mjs",
    "rendu": "vite build --config vite.rendu.config.ts --logLevel warn && node scripts/rendu.mjs",
    "auditer": "node scripts/audit.mjs && npm run rendu",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "controle": "npm run lint && npm run verifier && npm run test && npm run audit && npm run rendu && vite build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "lucide-react": "^0.545.0",
    "motion": "^12.23.12",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^31.0.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.1.4",
    "vitest": "^5.1.0"
  }
}
